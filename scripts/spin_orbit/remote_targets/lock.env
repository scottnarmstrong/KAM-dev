# Remote target: the N = 65 lock chain (LOCK-DATA). Sourced by lock_remote_runbook.sh; no secrets.
T_NAME=lock
T_SRC=/root/code/KAM-inp-lockdata                     # local worktree (sources; untracked lock data are symlinks)
T_FROZEN_FILE=$T_SRC/.drafts/REEMIT-DONE              # holds the frozen commit (40 hex)
T_BRANCH=inp-lockdata
T_RDIR=/root/kam-lock                                 # remote worktree
T_PFX=KAM.SpinOrbit.Data.LockN65                      # module prefix of the chain (lock_mlane closure)
T_TARGETS="KAM.SpinOrbit.Data.LockN65.AssemblyN65"    # its closure is the whole chain
T_SRCDIRS="KAM/SpinOrbit/Data/LockN65"                # untracked sources under these dirs go by rsync -L
T_OUTREL=KAM/SpinOrbit/Data/LockN65                   # outputs returned: .lake/build/{lib/lean,ir}/$T_OUTREL
T_NOBUILD="KAM.SpinOrbit.Data.LockN65.AssemblyN65 KAMLunarLock"   # local `lake build --no-build` after return
T_AUDIT_FIXED="KAM/SpinOrbit/Data/LockN65/Pass/*.lean KAM/SpinOrbit/Data/LockN65/Passes.lean KAM/SpinOrbit/Data/LockN65/AssemblyN65.lean"
T_AUDIT_POOL=KAM/SpinOrbit/Data/LockN65/Seg           # seeded random AUDIT_PCT % of these modules
