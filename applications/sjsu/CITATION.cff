    authors:
      - family-names: Sansottera
        given-names: Marco
      - family-names: Locatelli
        given-names: Ugo
      - family-names: Giorgilli
        given-names: Antonio
    title: "On the stability of the secular evolution of the planar Sun-Jupiter-Saturn-Uranus system"
    journal: "Mathematics and Computers in Simulation"
    volume: 88
    start: 1
    end: 14
    year: 2013
    doi: 10.1016/j.matcom.2010.11.018
  - type: article
    authors:
      - family-names: Giorgilli
        given-names: Antonio
      - family-names: Locatelli
        given-names: Ugo
      - family-names: Sansottera
        given-names: Marco
    title: "Secular dynamics of a planar model of the Sun-Jupiter-Saturn-Uranus system; effective stability into the light of Kolmogorov and Nekhoroshev theories"
    journal: "Regular and Chaotic Dynamics"
    volume: 22
    issue: 1
    start: 54
    end: 77
    year: 2017
    doi: 10.1134/S156035471701004X
