module

public import KAM.CertificateSharp.V2.SiteShard
public import KAM.CertificateSharp.V2.Tests.SiteSign

/-!
# Cross-language test of the site mirror (generated)

Generated by `scripts/certifier/lg00_sites_emit.py`. `scripts/certifier/bite_sign.py` evaluates
`balBound` in exact rationals; here the kernel compares it with Lean's, through a fingerprint
(numerator and denominator modulo `2^61 - 1`), on a toy bite and on the real site `b₀` of LG00 T′.
The toy bite also goes through `biteOk_of_shards`, and the real one through `biteOk` itself, on the
reflected short box of the T′ data.
-/

@[expose] public section

namespace KAM.CertificateSharp.V2.SiteMirror

open KAM.Certificate KAM.CertificateSharp KAM.Sharp2.Examples

/-- The fingerprint of a rational. -/
def fp (x : ℚ) : ℤ × ℕ := (x.num % 2305843009213693951, x.den % 2305843009213693951)

/-- The toy bite. -/
def toyW : BiteWit := ⟨1 / 100000, 3, 16, 12 / 100000⟩

/-- Its data. -/
def toyD : SdsData := biteData toyCert2.freqBox (1 / 2) (1 / 42) 1 toyW

theorem toy_check : balCheck toyD 3 = true := by decide +kernel

theorem toy_bound :
    fp (balBound toyD 3) = (1267779800124650458,
      1756160780947708258) := by decide +kernel

theorem toy_shard0 :
    shardOk toyD 2 (0 * 2 ^ 2) (401657577 / 5000000000000 : ℚ) = true := by decide +kernel

theorem toy_shard1 :
    shardOk toyD 2 (1 * 2 ^ 2)
      (61820153 / 6250000000000000000000000000000000 : ℚ) = true := by decide +kernel

/-- **The toy bite from two blocks.** -/
theorem toy_bite_of_shards :
    biteOk toyCert2.freqBox (1 / 2) (1 / 42) 1 (1 / 5000) toyW = true := by
  refine biteOk_of_shards (l₀ := 2) (M := 1) rfl [(401657577 / 5000000000000 : ℚ),
    (61820153 / 6250000000000000000000000000000000 : ℚ)] (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (fun j hj => ?_) (by decide +kernel)
    (by decide +kernel)
  have hj' : j = 0 ∨ j = 1 := by omega
  rcases hj' with rfl | rfl
  · exact toy_shard0
  · exact toy_shard1

/-- The last coordinate of T′, reflected. -/
def lgκ : ℚ := (12961718757584703 / 312500312500000 : ℚ)

/-- The Diophantine constant of T′. -/
def lgγ : ℚ := (116655468818262327 / 12500012500000000 : ℚ)

/-- The short reflected box of T′. -/
def lgBox : FreqBox := [((2050168234036912088766398376021 /
      87961018183010222080000000000 : ℚ),
    (12961718757584703 / 43980509091505111040000000000 : ℚ)),
    ((12961718757584703 / 312500312500000 : ℚ),
    0)]

/-- The certified bite at `b₀ = ρ`. -/
def lgW : BiteWit := ⟨(929743 / 1000000 : ℚ), 8, 8, (1034803 / 200 : ℚ)⟩

theorem lg_bound : fp (balBound (biteData lgBox lgκ lgγ (29 / 5000 : ℚ) lgW) 8) =
    (693257282406752538,
      96307337333083881) := by decide +kernel

/-- **The real site `b₀` of LG00 T′.** -/
theorem lg_bite :
    biteOk lgBox lgκ lgγ (29 / 5000 : ℚ) (2989 / 100000 : ℚ) lgW = true := by decide +kernel

end KAM.CertificateSharp.V2.SiteMirror

end
