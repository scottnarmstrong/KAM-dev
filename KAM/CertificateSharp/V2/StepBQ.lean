module

public import KAM.Sharp2.ModConstantsB

/-!
# Exact rational mirror of the constants of route B

Every constant of the repaired modified step `KAM.Sharp2.stepConstsB` is a rational at rational
inputs with a natural exponent `κ`. `StepBQ` is the rational record, `StepBQ.toB` its real image,
and `StepBQ.sX` the mirror of each helper `KAM.Sharp2.sX` of `ModConstantsB/Data.lean` (one per
`let` of `stepConstsB`; `stepConstsB_eq` is `rfl`), with `StepBQ.cast_sX : sX p.toB = (p.sX : ℝ)`.
`StepBQ.condB` is the Boolean form of `stepCondB`, and `StepBQ.condB_sound` its soundness.

The isoenergetic, stage-0 and L10 branches are kept: `iso`, `stage0`, `selfcons` are fields.
Generated by `scripts/apost_sharp/gen_stepbq.py` from the helper definitions (bodies copied).
-/

@[expose] public section

namespace KAM.CertificateSharp.V2

/-- The rational inputs of one modified step of route B, with a natural exponent `κ`. -/
structure StepBQ where
  n : ℕ
  κ : ℕ
  M1 : ℚ
  M2 : ℚ
  cTh : ℚ
  cDTh : ℚ
  sK : ℚ
  sLt : ℚ
  sB : ℚ
  sN : ℚ
  sNt : ℚ
  sT : ℚ
  ts : ℚ
  bF : ℚ
  c : ℚ
  c1 : ℚ
  cavg : ℚ
  θ : ℚ
  θξ : ℚ
  θΩ : ℚ
  q : ℚ
  θN : ℚ
  θω : ℚ
  a : ℚ
  lam : ℚ
  γb : ℚ
  δ : ℚ
  selfcons : Bool
  stage0 : Bool
  ePer : ℚ
  iso : Bool
  Θ : ℚ
  y0 : ℚ
  Mh2 : ℚ
  lamW : ℚ

namespace StepBQ

/-- The real record. -/
noncomputable def toB (p : StepBQ) : KAM.Sharp2.StepInB :=
  { n := p.n, κ := p.κ, M1 := p.M1, M2 := p.M2, cTh := p.cTh, cDTh := p.cDTh, sK := p.sK,
    sLt := p.sLt, sB := p.sB, sN := p.sN, sNt := p.sNt, sT := p.sT, ts := p.ts, bF := p.bF,
    c := p.c, c1 := p.c1, cavg := p.cavg, θ := p.θ, θξ := p.θξ, θΩ := p.θΩ, q := p.q, θN := p.θN,
    θω := p.θω, a := p.a, lam := p.lam, γb := p.γb, δ := p.δ, selfcons := p.selfcons,
    stage0 := p.stage0, ePer := p.ePer, iso := p.iso, Θ := p.Θ, y0 := p.y0, Mh2 := p.Mh2,
    lamW := p.lamW }

/-! ### The constants -/

def sg (p : StepBQ) : ℚ :=
  p.γb * p.δ ^ p.κ

def sg1 (p : StepBQ) : ℚ :=
  sg p * p.δ

def sKt (p : StepBQ) : ℚ :=
  (1 + p.θ) * p.sK

def st (p : StepBQ) : ℚ :=
  p.cTh * p.sNt * p.sN + p.ts

def saw (p : StepBQ) : ℚ :=
  if p.iso then 1 + p.θω else 1

def sCΩ (p : StepBQ) : ℚ :=
  2 * ((p.n : ℚ) - 1) * p.c1

def sCEL (p : StepBQ) : ℚ :=
  (p.sK + p.sN * p.q) / (1 - p.q ^ 2)

def sCEN (p : StepBQ) : ℚ :=
  (p.sN + p.sK * p.q) / (1 - p.q ^ 2)

def sCE0 (p : StepBQ) : ℚ :=
  p.lam * sCEL p + sg p * sCEN p

def sCE (p : StepBQ) : ℚ :=
  if p.stage0 then min (sCE0 p) p.ePer else sCE0 p

def sCDE0 (p : StepBQ) : ℚ :=
  (p.n : ℚ) * (p.sK + p.sN) * (max p.lam (sg p) + (p.sLt + p.sNt) * sCE p) / (1 - p.q)

def sCDE (p : StepBQ) : ℚ :=
  if p.stage0 then min (sCDE0 p) ((p.n : ℚ) * p.ePer) else sCDE0 p

def sCNN (p : StepBQ) : ℚ :=
  (p.n : ℚ) * (p.lam + p.sNt * sCE p)

def sC0 (p : StepBQ) : ℚ :=
  if p.iso then p.sT * max (p.lam + st p * p.cavg) (p.lamW + p.y0 * p.cavg)
  else p.sT * (p.lam + st p * p.cavg)

def sCxiN (p : StepBQ) : ℚ :=
  sC0 p + p.c

def sCKt (p : StepBQ) : ℚ :=
  p.sN * sCxiN p

def sCDLt (p : StepBQ) : ℚ :=
  (p.n : ℚ) * p.sN * (sC0 p + p.c1)

def sCDLtT (p : StepBQ) : ℚ :=
  2 * (p.n : ℚ) * p.sN * (sC0 p + p.c1)

def sCdN (p : StepBQ) : ℚ :=
  (p.M1 * p.sK + p.n) * p.sB +
  p.sN * ((p.sLt * p.M1 + 2 * p.n) * p.sK + p.sLt * (p.M1 * p.sK + p.n)) * p.sB

def sCXN (p : StepBQ) : ℚ :=
  p.M1 * p.sN + sCdN p

def sCEt (p : StepBQ) : ℚ :=
  sCE p + sCXN p * sCxiN p + p.sN * sg p + p.M2 / 2 * sCKt p +
  (if p.iso then sKt p * p.Θ * sC0 p else 0)

def sQtN (p : StepBQ) : ℚ :=
  sCDLtT p * sCEt p + sCNN p * sCxiN p + p.δ * p.sLt * (p.M2 / 2) * sCKt p ^ 2

def sCgL (p : StepBQ) : ℚ :=
  p.lam + st p * sCxiN p + (if p.iso then p.Θ * sC0 p else 0)

def sCxiL (p : StepBQ) : ℚ :=
  p.c * sCgL p

def sCDK (p : StepBQ) : ℚ :=
  p.sK * sCxiL p + sg p * sCKt p

def sCEb (p : StepBQ) : ℚ :=
  sCEt p + saw p * sKt p * sCgL p

def sCG (p : StepBQ) : ℚ :=
  (p.n : ℚ) * p.sLt + 2 * (p.n : ℚ) * p.sK

def sCBb (p : StepBQ) : ℚ :=
  p.sB ^ 2 * sCG p * sCDK p / (1 - p.θ)

def sCNb (p : StepBQ) : ℚ :=
  (p.n : ℚ) * sCDK p * p.sB + p.sK * sCBb p

def sCNbT (p : StepBQ) : ℚ :=
  sCBb p * p.sLt + 2 * (p.n : ℚ) * sCDK p * p.sB

def sw (p : StepBQ) : ℚ :=
  2 * p.M1 * p.sLt * p.sK + 2 * (p.n : ℚ) * p.sK + (p.n : ℚ) * p.sLt

def sCab0 (p : StepBQ) : ℚ :=
  p.cTh * (sCNbT p * p.sN + p.sNt * sCNb p) +
  p.cDTh * p.sNt * p.sN * sCDK p * p.δ

def sCab (p : StepBQ) : ℚ :=
  if p.iso then max (sCab0 p + p.Θ * sC0 p * sg1 p) ((p.n : ℚ) * p.Θ * sC0 p * sg1 p)
  else sCab0 p

def sBsup (p : StepBQ) : ℚ :=
  (p.sNt * p.sB * sCDE p + p.sB ^ 3 * sw p * sCΩ p) * sg p

def sBloc (p : StepBQ) : ℚ :=
  if p.iso then max (sBsup p) ((p.n : ℚ) * sg1 p) else sBsup p

def sQbN (p : StepBQ) : ℚ :=
  if p.iso then (1 + (p.n : ℚ) * p.θξ) * (1 + (1 + saw p) * p.θΩ) * sQtN p
  else (1 + (p.n : ℚ) * p.θξ) * (1 + p.θΩ) * sQtN p

def sQL1 (p : StepBQ) : ℚ :=
  p.sNt * (p.M2 / 2) * sCKt p ^ 2 * sg1 p + p.sB ^ 2 * sCΩ p * sg p ^ 2 +
  (p.n : ℚ) * p.sNt * sCEt p * sCxiL p +
  saw p * p.sNt * sCgL p * ((p.n : ℚ) * sKt p * sCxiL p + sg p * sCDLt p) +
  (if p.iso then sC0 p * sCgL p * sg1 p + sC0 p * p.sNt * sCDLt p * p.Θ * sg p else 0)

def sQLc (p : StepBQ) : ℚ :=
  sQL1 p + sCNbT p * sCEb p

def sQLs (p : StepBQ) : ℚ :=
  if p.selfcons then
    min (sQLc p) ((sQL1 p + p.θN * (sCEN p / sCEL p) * sQbN p * sg p) / (1 - p.θN))
  else sQLc p

def sQw (p : StepBQ) : ℚ :=
  p.Mh2 / 2 * sCKt p ^ 2 * sg1 p + (p.n : ℚ) * sQtN p * p.θξ * (p.Θ * sCΩ p + sg1 p)

def sQL (p : StepBQ) : ℚ :=
  if p.iso then max (sQLs p) (sQw p) else sQLs p

def sQ (p : StepBQ) : ℚ :=
  max (sQL p) (p.a ^ p.κ * sQbN p)

def sCnu (p : StepBQ) : ℚ :=
  if p.iso then p.Θ * sC0 p else 0

