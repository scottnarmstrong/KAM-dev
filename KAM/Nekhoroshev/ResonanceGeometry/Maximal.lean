module

public import KAM.Nekhoroshev.ResonanceGeometry.Volume

/-!
# Maximal `K`-lattices (`bpN:p8:klattice`, `bpN:p8:maximal`)

A `K`-lattice is an integer lattice generated by its vectors in the Euclidean ball of radius `K`;
it is maximal when no strictly larger `K`-lattice has the same rank. We prove finiteness of the set
of `K`-lattices (the Euclidean ball is a finite coordinate box), the existence of a short
independent generating sublattice, the saturation characterization of maximality, and the volume
bounds `1 ≤ vol Λ ≤ K ^ rank Λ`.
-/

@[expose] public noncomputable section
open Set Matrix Module Classical

namespace KAM.Nekhoroshev
open KAM.Stability
variable {n : ℕ}

def klattice (K : ℝ) (Λ : Lattice n) : Prop :=
  AddSubgroup.closure ((Λ : Set _) ∩ eBall n K) = Λ

def maximalK (K : ℝ) (Λ : Lattice n) : Prop :=
  klattice K Λ ∧ ∀ Λ' : Lattice n, klattice K Λ' → Λ ≤ Λ' →
    latticeDim Λ' = latticeDim Λ → Λ' = Λ

section Ball

theorem abs_coord_le_euclid (k : Fin n → ℤ) (i : Fin n) :
    |(k i : ℝ)| ≤ euclid (integerReal k) := by
  apply Real.abs_le_sqrt
  calc (k i : ℝ) ^ 2 = ‖integerReal k i‖ ^ 2 := by simp [integerReal]
    _ ≤ ∑ j, ‖integerReal k j‖ ^ 2 :=
      Finset.single_le_sum (f := fun j => ‖integerReal k j‖ ^ 2) (fun j _ => by positivity)
        (Finset.mem_univ i)

theorem eBall_finite (n : ℕ) (K : ℝ) : (eBall n K).Finite := by
  have h : eBall n K ⊆ Set.pi Set.univ (fun _ : Fin n => (Set.Icc (-⌈K⌉) ⌈K⌉ : Set ℤ)) := by
    intro k hk i _
    have h1 : |(k i : ℝ)| ≤ K := (abs_coord_le_euclid k i).trans hk
    have h2 := abs_le.1 h1
    have h3 : (k i : ℝ) ≤ (⌈K⌉ : ℝ) := h2.2.trans (Int.le_ceil K)
    have h4 : (-(⌈K⌉ : ℝ)) ≤ k i := by linarith [Int.le_ceil K]
    exact ⟨by exact_mod_cast h4, by exact_mod_cast h3⟩
  exact (Set.Finite.pi (fun _ => Set.finite_Icc _ _)).subset h

theorem eq_zero_of_mem_eBall_of_lt_one {K : ℝ} (hK : K < 1) {k : Fin n → ℤ}
    (hk : k ∈ eBall n K) : k = 0 := by
  by_contra hne
  obtain ⟨i, hi⟩ := Function.ne_iff.1 hne
  have h1 : (1 : ℝ) ≤ |(k i : ℝ)| := by
    have : (1 : ℤ) ≤ |k i| := Int.one_le_abs hi
    exact_mod_cast this
  have := (abs_coord_le_euclid k i).trans hk
  linarith

theorem klattice_finite (K : ℝ) : {Λ : Lattice n | klattice K Λ}.Finite := by
  refine Set.Finite.of_finite_image
    (f := fun Λ : Lattice n => (Λ : Set (Fin n → ℤ)) ∩ eBall n K) ?_ ?_
  · refine (eBall_finite n K).finite_subsets.subset ?_
    rintro _ ⟨Λ, _, rfl⟩
    exact inter_subset_right
  · intro Λ hΛ Γ hΓ h
    have h' : (Λ : Set (Fin n → ℤ)) ∩ eBall n K = (Γ : Set (Fin n → ℤ)) ∩ eBall n K := h
    calc Λ = AddSubgroup.closure ((Λ : Set (Fin n → ℤ)) ∩ eBall n K) := hΛ.symm
      _ = AddSubgroup.closure ((Γ : Set (Fin n → ℤ)) ∩ eBall n K) := by rw [h']
      _ = Γ := hΓ

end Ball

section Span

theorem integerReal_add (x y : Fin n → ℤ) :
    integerReal (x + y) = integerReal x + integerReal y := by
  ext i; simp [integerReal]

theorem integerReal_neg (x : Fin n → ℤ) : integerReal (-x) = -integerReal x := by
  ext i; simp [integerReal]

theorem integerReal_zero : integerReal (0 : Fin n → ℤ) = 0 := by
  ext i; simp [integerReal]

theorem integerReal_zsmul (m : ℤ) (x : Fin n → ℤ) :
    integerReal (m • x) = (m : ℝ) • integerReal x := by
  ext i; simp [integerReal]

theorem lattice_le_iff {Γ : Lattice n} {V : Submodule ℝ (Fin n → ℝ)} :
    lattice Γ ≤ V ↔ ∀ x ∈ Γ, integerReal x ∈ V := by
  constructor
  · intro h x hx
    exact h (integerReal_mem_lattice hx)
  · intro h
    refine Submodule.span_le.2 ?_
    rintro _ ⟨k, hk, rfl⟩
    exact h k hk

theorem lattice_mono {Λ Γ : Lattice n} (h : Λ ≤ Γ) : lattice Λ ≤ lattice Γ :=
  lattice_le_iff.2 fun _ hx => integerReal_mem_lattice (h hx)

theorem lattice_eq_of_le_dim {Λ Γ : Lattice n} (h : Λ ≤ Γ) (hd : latticeDim Λ = latticeDim Γ) :
    lattice Λ = lattice Γ :=
  Submodule.eq_of_le_of_finrank_eq (lattice_mono h) hd

theorem lattice_addVector_le {Λ : Lattice n} {k : Fin n → ℤ} (hk : integerReal k ∈ lattice Λ) :
    lattice (addVector Λ k) ≤ lattice Λ := by
  refine lattice_le_iff.2 fun x hx => ?_
  obtain ⟨y, hy, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 hx
  obtain ⟨m, rfl⟩ := AddSubgroup.mem_closure_singleton.1 hz
  rw [integerReal_add, integerReal_zsmul]
  exact add_mem (integerReal_mem_lattice hy) (Submodule.smul_mem _ _ hk)

theorem integerReal_mem_span_of_klattice {K : ℝ} {Λ : Lattice n} (hΛ : klattice K Λ)
    {x : Fin n → ℤ} (hx : x ∈ Λ) :
    integerReal x ∈ Submodule.span ℝ (integerReal '' ((Λ : Set (Fin n → ℤ)) ∩ eBall n K)) := by
  rw [← hΛ] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem y hy => exact Submodule.subset_span ⟨y, hy, rfl⟩
  | zero => rw [integerReal_zero]; exact Submodule.zero_mem _
  | add y z _ _ hy hz => rw [integerReal_add]; exact Submodule.add_mem _ hy hz
  | neg y _ hy => rw [integerReal_neg]; exact Submodule.neg_mem _ hy

/-- A `K`-lattice has an `ℝ`-independent family of `rank` generators in the `K`-ball. -/
theorem klattice_short_basis {K : ℝ} {Λ : Lattice n} (hΛ : klattice K Λ) :
    ∃ v : Fin (latticeDim Λ) → (Fin n → ℤ), (∀ j, v j ∈ Λ) ∧ (∀ j, v j ∈ eBall n K) ∧
      LinearIndependent ℝ (fun j => integerReal (v j)) := by
  set s : Set (Fin n → ℝ) := integerReal '' ((Λ : Set (Fin n → ℤ)) ∩ eBall n K) with hs
  have hspan : Submodule.span ℝ s = lattice Λ := by
    apply le_antisymm
    · refine Submodule.span_le.2 ?_
      rintro _ ⟨x, hx, rfl⟩
      exact integerReal_mem_lattice hx.1
    · exact lattice_le_iff.2 fun x hx => integerReal_mem_span_of_klattice hΛ hx
  obtain ⟨b, hbs, hbspan, hbli⟩ := exists_linearIndependent ℝ s
  have : Fintype b := (hbli.set_finite_of_isNoetherian).fintype
  have hcard : Fintype.card b = latticeDim Λ := by
    have h := finrank_span_eq_card hbli
    rw [Subtype.range_coe, hbspan, hspan] at h
    simpa [latticeDim] using h.symm
  have hpre : ∀ x : b, ∃ w : Fin n → ℤ, w ∈ (Λ : Set (Fin n → ℤ)) ∩ eBall n K ∧
      integerReal w = x.1 := fun x => hbs x.2
  choose w hw hwx using hpre
  let e : Fin (latticeDim Λ) ≃ b := (finCongr hcard.symm).trans (Fintype.equivFin b).symm
  refine ⟨fun j => w (e j), fun j => (hw _).1, fun j => (hw _).2, ?_⟩
  have : (fun j => integerReal (w (e j))) = (fun x : b => x.1) ∘ e := by
    funext j; exact hwx (e j)
  rw [this]
  exact hbli.comp e e.injective

end Span

section Maximal

theorem klattice_bot (K : ℝ) : klattice K (⊥ : Lattice n) :=
  le_antisymm ((AddSubgroup.closure_le _).2 inter_subset_left) bot_le

theorem latticeDim_bot : latticeDim (⊥ : Lattice n) = 0 :=
  (lattice_resonance (⊥ : Lattice n)).2.2 rfl

theorem maximalK_bot (K : ℝ) : maximalK K (⊥ : Lattice n) :=
  ⟨klattice_bot K, fun Γ _ _ hd => by
    rw [latticeDim_bot] at hd
    exact (lattice_resonance Γ).2.1 hd⟩

theorem klattice_addVector {K : ℝ} {Λ : Lattice n} (hΛ : klattice K Λ) {k : Fin n → ℤ}
    (hk : k ∈ eBall n K) : klattice K (addVector Λ k) := by
  have hle : Λ ≤ addVector Λ k := le_sup_left
  have hmem : k ∈ addVector Λ k := le_sup_right (a := Λ) (AddSubgroup.subset_closure rfl)
  apply le_antisymm
  · exact (AddSubgroup.closure_le _).2 inter_subset_left
  · refine sup_le ?_ ?_
    · exact hΛ.symm.trans_le
        (AddSubgroup.closure_mono (inter_subset_inter_left _ (fun x hx => hle hx)))
    · exact AddSubgroup.closure_mono (by rintro _ rfl; exact ⟨hmem, hk⟩)

theorem mem_of_maximalK {K : ℝ} {Λ : Lattice n} (h : maximalK K Λ) {k : Fin n → ℤ}
    (hk : k ∈ eBall n K) (hkΛ : integerReal k ∈ lattice Λ) : k ∈ Λ := by
  have hle : Λ ≤ addVector Λ k := le_sup_left
  have hdim : latticeDim (addVector Λ k) = latticeDim Λ := by
    have : lattice (addVector Λ k) = lattice Λ :=
      le_antisymm (lattice_addVector_le hkΛ) (lattice_mono hle)
    unfold latticeDim
    rw [this]
  have := h.2 _ (klattice_addVector h.1 hk) hle hdim
  rw [← this]
  exact le_sup_right (a := Λ) (AddSubgroup.subset_closure rfl)

theorem maximalK_of_forall {K : ℝ} {Λ : Lattice n} (hΛ : klattice K Λ)
    (h : ∀ k ∈ eBall n K, integerReal k ∈ lattice Λ → k ∈ Λ) : maximalK K Λ := by
  refine ⟨hΛ, fun Γ hΓ hle hd => ?_⟩
  refine le_antisymm ?_ hle
  calc Γ = AddSubgroup.closure ((Γ : Set (Fin n → ℤ)) ∩ eBall n K) := hΓ.symm
    _ ≤ Λ := by
      rw [AddSubgroup.closure_le]
      rintro x ⟨hxΓ, hxe⟩
      refine h x hxe ?_
      rw [lattice_eq_of_le_dim hle hd.symm]
      exact integerReal_mem_lattice hxΓ

theorem exists_maximalK_above {K : ℝ} {Λ : Lattice n} (hΛ : klattice K Λ) :
    ∃ Λ' : Lattice n, maximalK K Λ' ∧ Λ ≤ Λ' ∧ latticeDim Λ' = latticeDim Λ := by
  set S : Set (Lattice n) := {Γ | klattice K Γ ∧ Λ ≤ Γ ∧ latticeDim Γ = latticeDim Λ} with hS
  have hfin : S.Finite := (klattice_finite K).subset fun Γ hΓ => hΓ.1
  obtain ⟨Γ, hΓ, hmax⟩ := hfin.exists_maximal ⟨Λ, hΛ, le_rfl, rfl⟩
  refine ⟨Γ, ⟨hΓ.1, fun Γ' hΓ' hle hd => ?_⟩, hΓ.2.1, hΓ.2.2⟩
  exact le_antisymm (hmax ⟨hΓ', hΓ.2.1.trans hle, hd.trans hΓ.2.2⟩ hle) hle

theorem units_top {Γ : Lattice n} (h : ∀ i : Fin n, (Pi.single i (1 : ℤ) : Fin n → ℤ) ∈ Γ) :
    Γ = ⊤ := by
  refine eq_top_iff.2 fun k _ => ?_
  have : k = ∑ i, k i • (Pi.single i (1 : ℤ) : Fin n → ℤ) := by
    ext j; simp [Finset.sum_apply, Pi.single_apply]
  rw [this]
  exact sum_mem fun i _ => zsmul_mem (h i) _

theorem single_mem_eBall {K : ℝ} (hK : 1 ≤ K) (i : Fin n) :
    (Pi.single i (1 : ℤ) : Fin n → ℤ) ∈ eBall n K := by
  show euclid (integerReal (Pi.single i (1 : ℤ) : Fin n → ℤ)) ≤ K
  have : euclid (integerReal (Pi.single i (1 : ℤ) : Fin n → ℤ)) = 1 := by
    unfold euclid
    rw [Real.sqrt_eq_one]
    simp [integerReal, Pi.single_apply]
  rw [this]; exact hK

theorem klattice_top {K : ℝ} (hK : 1 ≤ K) : klattice K (⊤ : Lattice n) := by
  exact (units_top (Γ := AddSubgroup.closure (((⊤ : Lattice n) : Set (Fin n → ℤ)) ∩ eBall n K))
    fun i => AddSubgroup.subset_closure ⟨trivial, single_mem_eBall hK i⟩)

theorem volume_le_of_klattice {K : ℝ} {Λ : Lattice n} (hΛ : klattice K Λ) :
    volume_def Λ ≤ K ^ latticeDim Λ := by
  obtain ⟨v, hvΛ, hvK, hvli⟩ := klattice_short_basis hΛ
  have hle : AddSubgroup.closure (Set.range v) ≤ Λ := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    exact hvΛ j
  have hdim : latticeDim (AddSubgroup.closure (Set.range v)) = latticeDim Λ :=
    latticeDim_closure v (integer_independent_of_real v hvli)
  refine (volume_mono hle hdim).trans ((lattice_volume_hadamard v hvli).trans ?_)
  calc ∏ j, euclid (integerReal (v j)) ≤ ∏ _j : Fin (latticeDim Λ), K :=
        Finset.prod_le_prod₀ (fun j _ => euclid_nonneg' _) (fun j _ => hvK j)
    _ = K ^ latticeDim Λ := by simp

theorem maximal {K : ℝ} (hK : 0 ≤ K) (Λ : Lattice n) :
    (klattice K Λ → (maximalK K Λ ↔ ∀ k ∈ eBall n K, integerReal k ∈ lattice Λ → k ∈ Λ)) ∧
    maximalK K (⊥ : Lattice n) ∧
    (klattice K Λ → (∀ k, integerReal k ∈ lattice Λ → k ∈ Λ) → maximalK K Λ) ∧
    (klattice K Λ → ∃ Λ' : Lattice n, maximalK K Λ' ∧ Λ ≤ Λ' ∧ latticeDim Λ' = latticeDim Λ) ∧
    (∀ k ∈ eBall n K, k ≠ 0 → ∃ Λ' : Lattice n, maximalK K Λ' ∧ latticeDim Λ' = 1 ∧ k ∈ Λ') ∧
    (maximalK K Λ → ∀ k ∈ eBall n K, k ∉ Λ → integerReal k ∉ lattice Λ ∧
      latticeDim Λ < n ∧ klattice K (addVector Λ k) ∧
      latticeDim (addVector Λ k) = latticeDim Λ + 1) ∧
    (maximalK K Λ → latticeDim Λ = n → eBall n K ⊆ (Λ : Set _)) ∧
    (1 ≤ K → maximalK K (⊤ : Lattice n) ∧
      (maximalK K Λ → latticeDim Λ = n → Λ = ⊤)) ∧
    (K < 1 → (maximalK K Λ ↔ Λ = ⊥)) ∧
    (maximalK K Λ → 1 ≤ volume_def Λ ∧ volume_def Λ ≤ K ^ latticeDim Λ) := by
  have hsat : ∀ k ∈ eBall n K, maximalK K Λ → k ∉ Λ →
      integerReal k ∉ lattice Λ ∧ latticeDim Λ < n ∧ klattice K (addVector Λ k) ∧
      latticeDim (addVector Λ k) = latticeDim Λ + 1 := by
    intro k hk hΛ hkΛ
    have hreal : integerReal k ∉ lattice Λ := fun h => hkΛ (mem_of_maximalK hΛ hk h)
    have hdim := (addVector_facts Λ k hreal).1
    refine ⟨hreal, ?_, klattice_addVector hΛ.1 hk, hdim⟩
    have := (lattice_basis (addVector Λ k)).1
    omega
  have hfull : maximalK K Λ → latticeDim Λ = n → eBall n K ⊆ (Λ : Set _) := by
    intro hΛ hd k hk
    by_contra hkΛ
    have := (hsat k hk hΛ hkΛ).2.1
    omega
  refine ⟨fun hΛ => ⟨fun h k hk hkl => mem_of_maximalK h hk hkl, maximalK_of_forall hΛ⟩,
    maximalK_bot K,
    fun hΛ h => maximalK_of_forall hΛ fun k _ hk => h k hk,
    fun hΛ => exists_maximalK_above hΛ, ?_, fun hΛ k hk hkΛ => hsat k hk hΛ hkΛ, hfull,
    fun h1 => ⟨⟨klattice_top h1, fun Γ _ hle _ => top_le_iff.1 hle⟩, ?_⟩, fun h1 => ⟨?_, ?_⟩, ?_⟩
  · intro k hk hk0
    have hcl : klattice K (AddSubgroup.closure {k}) := by
      apply le_antisymm
      · exact (AddSubgroup.closure_le _).2 inter_subset_left
      · exact AddSubgroup.closure_mono (fun x hx => ⟨AddSubgroup.subset_closure hx, by
          rw [Set.mem_singleton_iff.1 hx]; exact hk⟩)
    have hdim : latticeDim (AddSubgroup.closure {k}) = 1 := by
      have hli : LinearIndependent ℝ (fun _ : Fin 1 => integerReal k) := by
        refine LinearIndependent.of_subsingleton 0 ?_
        intro h
        exact hk0 (integerReal_injective (h.trans integerReal_zero.symm))
      have h := latticeDim_closure (fun _ : Fin 1 => k) (integer_independent_of_real _ hli)
      simpa [Set.range_const] using h
    obtain ⟨Λ', hΛ', hle, hd⟩ := exists_maximalK_above hcl
    exact ⟨Λ', hΛ', hd.trans hdim, hle (AddSubgroup.subset_closure rfl)⟩
  · intro hΛ hd
    exact units_top fun i => hfull hΛ hd (single_mem_eBall h1 i)
  · intro hΛ
    have hsub : ((Λ : Set (Fin n → ℤ)) ∩ eBall n K) ⊆ ((⊥ : Lattice n) : Set (Fin n → ℤ)) := by
      rintro x ⟨_, hx⟩
      exact eq_zero_of_mem_eBall_of_lt_one h1 hx
    have : Λ ≤ ⊥ := hΛ.1.symm.trans_le ((AddSubgroup.closure_le _).2 hsub)
    exact le_bot_iff.1 this
  · rintro rfl
    exact maximalK_bot K
  · intro hΛ
    exact ⟨one_le_volume Λ, volume_le_of_klattice hΛ.1⟩

end Maximal

end KAM.Nekhoroshev
