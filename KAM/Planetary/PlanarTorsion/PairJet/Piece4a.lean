public import KAM.Planetary.PlanarTorsion.PairJet.Reduction

/-!
# Planar quartic torsion: Fourier expansion and torus average of pieces of the pair jet

Blueprint P, Part 11b (`stepP:p11b:pj-bin`, `stepP:p11b:pj-avg`): the pieces q44a, q413, q422 of the binomial
expansion are expanded as finite Fourier sums (`p11cPJLN_*` neutral terms, `p11cPJLC_*` charged
terms) and averaged over the torus; only the neutral terms contribute.
-/

@[expose] public noncomputable section
open Set MeasureTheory Real Function Filter
open scoped Topology
namespace KAM.Planetary
open KAM.Planetary.OrbitJet

def p11cPJLN_q44a_0 (α ζ1 ζb1 ζ2 ζb2 : ℂ) : List PJTerm := [
    ⟨(1/64 : ℂ) * α * ζ1 ^ 2 * ζb1 ^ 2, 2, 2, 0, 0, 1, 0, 3⟩,
    ⟨(1/64 : ℂ) * α * ζ1 ^ 2 * ζb1 ^ 2, 2, 2, 0, 0, 0, 1, 3⟩,
    ⟨(3/16 : ℂ) * α * ζ1 ^ 2 * ζb1 * ζb2, 2, 1, 0, 1, 0, 1, 3⟩,
    ⟨(-1/64 : ℂ) * α * ζ1 ^ 2 * ζb2 ^ 2, 2, 0, 0, 2, 1, 0, 3⟩,
    ⟨(-9/64 : ℂ) * α * ζ1 ^ 2 * ζb2 ^ 2, 2, 0, 0, 2, 0, 1, 3⟩,
    ⟨(3/16 : ℂ) * α * ζ1 * ζb1 ^ 2 * ζ2, 1, 2, 1, 0, 1, 0, 3⟩,
    ⟨(-1/4 : ℂ) * α * ζ1 * ζb1 * ζ2 * ζb2, 1, 1, 1, 1, 1, 0, 3⟩,
    ⟨(-1/4 : ℂ) * α * ζ1 * ζb1 * ζ2 * ζb2, 1, 1, 1, 1, 0, 1, 3⟩,
    ⟨(3/16 : ℂ) * α * ζ1 * ζ2 * ζb2 ^ 2, 1, 0, 1, 2, 0, 1, 3⟩,
    ⟨(-9/64 : ℂ) * α * ζb1 ^ 2 * ζ2 ^ 2, 0, 2, 2, 0, 1, 0, 3⟩,
    ⟨(-1/64 : ℂ) * α * ζb1 ^ 2 * ζ2 ^ 2, 0, 2, 2, 0, 0, 1, 3⟩,
    ⟨(3/16 : ℂ) * α * ζb1 * ζ2 ^ 2 * ζb2, 0, 1, 2, 1, 1, 0, 3⟩,
    ⟨(1/64 : ℂ) * α * ζ2 ^ 2 * ζb2 ^ 2, 0, 0, 2, 2, 1, 0, 3⟩,
    ⟨(1/64 : ℂ) * α * ζ2 ^ 2 * ζb2 ^ 2, 0, 0, 2, 2, 0, 1, 3⟩]

def p11cPJLN_q44a (α ζ1 ζb1 ζ2 ζb2 : ℂ) : List PJTerm :=
  p11cPJLN_q44a_0 α ζ1 ζb1 ζ2 ζb2

