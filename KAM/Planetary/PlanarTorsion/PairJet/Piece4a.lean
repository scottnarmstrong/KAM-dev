def p11cPJLC_q44a (α ζ1 ζb1 ζ2 ζb2 : ℂ) : List PJTerm :=
  p11cPJLC_q44a_0 α ζ1 ζb1 ζ2 ζb2 ++
    p11cPJLC_q44a_1 α ζ1 ζb1 ζ2 ζb2

def p11cPJC_q44a_0 (a : ℝ) : ℝ :=
  ((1/32 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 1 a

def p11cPJC_q44a_1 (a : ℝ) : ℝ :=
  ((3/16 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 2 a

def p11cPJC_q44a_2 (a : ℝ) : ℝ :=
  ((-1/64 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 1 a +
        ((-9/64 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 3 a

def p11cPJC_q44a_3 (a : ℝ) : ℝ :=
  ((3/16 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 2 a

def p11cPJC_q44a_4 (a : ℝ) : ℝ :=
  ((-1/2 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 1 a

def p11cPJC_q44a_5 (a : ℝ) : ℝ :=
  ((3/16 : ℝ) * a) * p11c_laplace (3/2 : ℝ) 2 a

def p11cPJC_q44a_6 (a : ℝ) : ℝ :=
