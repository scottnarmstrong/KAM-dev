module

public import Mathlib
public import KAM.Planetary.SecularForm.InvariantPolynomial.Balanced

/-!
# Invariant polynomials: generators

A balanced monomial in `(z, w)` is a product of the functions `m_{jk} = z_j w_k`, and
`m_{jk} = d_{jk} + i c_{jk}` with the dot product `d_{jk}` and the cross product `c_{jk}`.
Hence the real and imaginary parts of the algebra generated by the `m_{jk}` lie in the algebra
`𝒟 ⊕ 𝒟·c` built from the dot products and the (odd) cross products, because every product of two
cross products is a polynomial in the dot products (Binet–Cauchy).
-/

@[expose] public noncomputable section
open MvPolynomial
namespace KAM.Planetary
namespace SecularForm
namespace Weyl

variable {n : ℕ}

/-- Configurations of `n` planar vectors. -/
abbrev Pt (n : ℕ) := Fin n → Fin 2 → ℝ

/-- The dot product `u_j · u_k`. -/
def dotFn (j k : Fin n) : Pt n → ℝ := fun u => planeDot (u j) (u k)

/-- The cross product `y_j x_k - x_j y_k`. -/
def crossFn (j k : Fin n) : Pt n → ℝ := fun u => u j 1 * u k 0 - u j 0 * u k 1

/-- The complex bilinear products `z_j w_k`. -/
def mFn (j k : Fin n) : Pt n → ℂ := fun u => zw u (j, true) * zw u (k, false)

theorem mFn_re (j k : Fin n) (u : Pt n) : (mFn j k u).re = dotFn j k u := by
  simp [mFn, zw, dotFn, planeDot, Fin.sum_univ_two]

theorem mFn_im (j k : Fin n) (u : Pt n) : (mFn j k u).im = crossFn j k u := by
  simp [mFn, zw, crossFn]; ring

theorem cross_mul_cross (j k l m : Fin n) :
    crossFn j k * crossFn l m = dotFn j l * dotFn k m - dotFn j m * dotFn k l := by
  funext u
  simp only [Pi.mul_apply, Pi.sub_apply, crossFn, dotFn, planeDot, Fin.sum_univ_two]
  ring

/-- The algebra of the complex bilinear products. -/
def cAlg (n : ℕ) : Subalgebra ℂ (Pt n → ℂ) :=
  Algebra.adjoin ℂ (Set.range fun jk : Fin n × Fin n => mFn jk.1 jk.2)

theorem balanced_mem (N : ℕ) :
    ∀ μ : Fin n × Bool →₀ ℕ, degT μ = N → degF μ = N →
      (fun u : Pt n => ∏ i, zw u i ^ μ i) ∈ cAlg n := by
  induction N with
  | zero =>
    intro μ hT hF
    have h0 : μ = 0 := by
      ext ⟨k, b⟩
      cases b
      · have := (Finset.sum_eq_zero_iff.mp hF) k (Finset.mem_univ _); simpa using this
      · have := (Finset.sum_eq_zero_iff.mp hT) k (Finset.mem_univ _); simpa using this
    subst h0
    convert (cAlg n).one_mem using 1
    funext u; simp
  | succ N ih =>
    intro μ hT hF
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ)
      (f := fun k => μ (k, true)) (by simpa [degT] using (by omega : degT μ ≠ 0))
    obtain ⟨k, -, hk⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ)
      (f := fun k => μ (k, false)) (by simpa [degF] using (by omega : degF μ ≠ 0))
    have hne : ((j, true) : Fin n × Bool) ≠ (k, false) := by simp
    set μ' : Fin n × Bool →₀ ℕ :=
      μ - Finsupp.single (j, true) 1 - Finsupp.single (k, false) 1 with hμ'
    have hdecomp : μ = μ' + Finsupp.single (j, true) 1 + Finsupp.single (k, false) 1 := by
      ext i
      have hj1 : 1 ≤ μ (j, true) := Nat.one_le_iff_ne_zero.mpr hj
      have hk1 : 1 ≤ μ (k, false) := Nat.one_le_iff_ne_zero.mpr hk
      simp only [hμ', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
      by_cases h1 : ((j, true) : Fin n × Bool) = i <;> by_cases h2 : ((k, false) : Fin n × Bool) = i
      · exact absurd (h1.trans h2.symm) hne
      · subst h1; simp [h2]; omega
      · subst h2; simp [h1]; omega
      · simp [h1, h2]
    have hT' : degT μ' = N := by
      have : degT μ = degT μ' + 1 := by
        conv_lhs => rw [hdecomp]
        simp [degT, Finsupp.add_apply, Finset.sum_add_distrib, Finsupp.single_apply]
      omega
    have hF' : degF μ' = N := by
      have : degF μ = degF μ' + 1 := by
        conv_lhs => rw [hdecomp]
        simp [degF, Finsupp.add_apply, Finset.sum_add_distrib, Finsupp.single_apply]
      omega
    have hfun : (fun u : Pt n => ∏ i, zw u i ^ μ i) =
        (fun u : Pt n => ∏ i, zw u i ^ μ' i) * mFn j k := by
      funext u
      conv_lhs => rw [hdecomp]
      simp only [Pi.mul_apply, mFn, Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]
      have e1 : ∏ i, zw u i ^ (Finsupp.single ((j, true) : Fin n × Bool) 1) i =
          zw u (j, true) := by
        simp [Finsupp.single_apply, pow_ite]
      have e2 : ∏ i, zw u i ^ (Finsupp.single ((k, false) : Fin n × Bool) 1) i =
          zw u (k, false) := by
        simp [Finsupp.single_apply, pow_ite]
      rw [e1, e2]
      ring
    rw [hfun]
    exact (cAlg n).mul_mem (ih μ' hT' hF')
      (Algebra.subset_adjoin ⟨(j, k), rfl⟩)

theorem balancedPart_mem (Q : MvPolynomial (Fin n × Bool) ℂ) :
    (fun u : Pt n => MvPolynomial.eval (zw u) (balancedPart Q)) ∈ cAlg n := by
  have : (fun u : Pt n => MvPolynomial.eval (zw u) (balancedPart Q)) =
      ∑ μ ∈ Q.support with degT μ = degF μ,
        Q.coeff μ • (fun u : Pt n => ∏ i, zw u i ^ μ i) := by
    funext u
    rw [eval_balancedPart]
    simp [Finset.sum_apply]
  rw [this]
  refine Subalgebra.sum_mem _ fun μ hμ => Subalgebra.smul_mem _ ?_ _
  have hμ' := (Finset.mem_filter.mp hμ).2
  exact balanced_mem (degT μ) μ rfl hμ'.symm

/-! ### Dot-product algebra and its odd part -/

/-- The algebra generated by the dot products. -/
def dAlg (n : ℕ) : Subalgebra ℝ (Pt n → ℝ) :=
  Algebra.adjoin ℝ (Set.range fun jk : Fin n × Fin n => dotFn jk.1 jk.2)

/-- `𝒟`-linear combinations of cross products. -/
def IsOdd (f : Pt n → ℝ) : Prop :=
  ∃ a : Fin n × Fin n → (Pt n → ℝ), (∀ p, a p ∈ dAlg n) ∧
    f = ∑ p, a p * crossFn p.1 p.2

theorem isOdd_zero : IsOdd (0 : Pt n → ℝ) :=
  ⟨fun _ => 0, fun _ => (dAlg n).zero_mem, by simp⟩

theorem IsOdd.add {f g : Pt n → ℝ} (hf : IsOdd f) (hg : IsOdd g) : IsOdd (f + g) := by
  obtain ⟨a, ha, rfl⟩ := hf
  obtain ⟨b, hb, rfl⟩ := hg
  exact ⟨fun p => a p + b p, fun p => (dAlg n).add_mem (ha p) (hb p), by
    simp [add_mul, Finset.sum_add_distrib]⟩

theorem IsOdd.mul_left {e f : Pt n → ℝ} (he : e ∈ dAlg n) (hf : IsOdd f) : IsOdd (e * f) := by
  obtain ⟨a, ha, rfl⟩ := hf
  exact ⟨fun p => e * a p, fun p => (dAlg n).mul_mem he (ha p), by
    simp [Finset.mul_sum, mul_assoc]⟩

theorem isOdd_cross (j k : Fin n) : IsOdd (crossFn j k) := by
  classical
  refine ⟨fun p => if p = (j, k) then 1 else 0, fun p => ?_, ?_⟩
  · by_cases h : p = (j, k)
    · simpa [h] using (dAlg n).one_mem
    · simpa [h] using (dAlg n).zero_mem
  · funext u
    rw [Finset.sum_apply]
    have h : ∀ x : Fin n × Fin n,
        (if x = (j, k) then (1 : Pt n → ℝ) else 0) u = if x = (j, k) then 1 else 0 := by
      intro x; split_ifs <;> rfl
    simp only [Pi.mul_apply, h, ite_mul, one_mul, zero_mul]
    simp

theorem IsOdd.mul_odd {f g : Pt n → ℝ} (hf : IsOdd f) (hg : IsOdd g) : f * g ∈ dAlg n := by
  obtain ⟨a, ha, rfl⟩ := hf
  obtain ⟨b, hb, rfl⟩ := hg
  rw [Finset.sum_mul_sum]
  refine Subalgebra.sum_mem _ fun p _ => Subalgebra.sum_mem _ fun q _ => ?_
  have : a p * crossFn p.1 p.2 * (b q * crossFn q.1 q.2) =
      a p * b q * (crossFn p.1 p.2 * crossFn q.1 q.2) := by ring
  rw [this, cross_mul_cross]
  refine (dAlg n).mul_mem ((dAlg n).mul_mem (ha p) (hb q)) ((dAlg n).sub_mem ?_ ?_)
  · exact (dAlg n).mul_mem (Algebra.subset_adjoin ⟨(p.1, q.1), rfl⟩)
      (Algebra.subset_adjoin ⟨(p.2, q.2), rfl⟩)
  · exact (dAlg n).mul_mem (Algebra.subset_adjoin ⟨(p.1, q.2), rfl⟩)
      (Algebra.subset_adjoin ⟨(p.2, q.1), rfl⟩)

/-- Dot products plus odd combinations of cross products form an algebra. -/
def sAlg (n : ℕ) : Subalgebra ℝ (Pt n → ℝ) where
  carrier := {f | ∃ e ∈ dAlg n, ∃ v, IsOdd v ∧ f = e + v}
  mul_mem' := by
    rintro _ _ ⟨e₁, he₁, v₁, hv₁, rfl⟩ ⟨e₂, he₂, v₂, hv₂, rfl⟩
    refine ⟨e₁ * e₂ + v₁ * v₂, (dAlg n).add_mem ((dAlg n).mul_mem he₁ he₂) (hv₁.mul_odd hv₂),
      e₁ * v₂ + e₂ * v₁, (hv₂.mul_left he₁).add (hv₁.mul_left he₂), by ring⟩
  add_mem' := by
    rintro _ _ ⟨e₁, he₁, v₁, hv₁, rfl⟩ ⟨e₂, he₂, v₂, hv₂, rfl⟩
    exact ⟨e₁ + e₂, (dAlg n).add_mem he₁ he₂, v₁ + v₂, hv₁.add hv₂, by ring⟩
  algebraMap_mem' := fun r => ⟨algebraMap ℝ _ r, (dAlg n).algebraMap_mem r, 0, isOdd_zero, by simp⟩

theorem dAlg_le_sAlg : dAlg n ≤ sAlg n := fun f hf => ⟨f, hf, 0, isOdd_zero, by simp⟩

theorem dotFn_mem_sAlg (j k : Fin n) : dotFn j k ∈ sAlg n :=
  dAlg_le_sAlg (Algebra.subset_adjoin ⟨(j, k), rfl⟩)

theorem crossFn_mem_sAlg (j k : Fin n) : crossFn j k ∈ sAlg n :=
  ⟨0, (dAlg n).zero_mem, crossFn j k, isOdd_cross j k, by simp⟩

/-- Real and imaginary parts of the algebra of the `z_j w_k` lie in `sAlg`. -/
theorem re_im_mem_sAlg {f : Pt n → ℂ} (hf : f ∈ cAlg n) :
    (fun u => (f u).re) ∈ sAlg n ∧ (fun u => (f u).im) ∈ sAlg n := by
  induction hf using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨j, k⟩, rfl⟩ := hx
    exact ⟨by simpa [mFn_re] using dotFn_mem_sAlg j k, by simpa [mFn_im] using crossFn_mem_sAlg j k⟩
  | algebraMap r =>
    refine ⟨?_, ?_⟩
    · have : (fun u : Pt n => ((algebraMap ℂ (Pt n → ℂ) r) u).re) = algebraMap ℝ _ r.re := by
        funext u; simp
      rw [this]; exact (sAlg n).algebraMap_mem _
    · have : (fun u : Pt n => ((algebraMap ℂ (Pt n → ℂ) r) u).im) = algebraMap ℝ _ r.im := by
        funext u; simp
      rw [this]; exact (sAlg n).algebraMap_mem _
  | add x y _ _ hx hy =>
    exact ⟨(sAlg n).add_mem hx.1 hy.1, (sAlg n).add_mem hx.2 hy.2⟩
  | mul x y _ _ hx hy =>
    refine ⟨?_, ?_⟩
    · have := (sAlg n).sub_mem ((sAlg n).mul_mem hx.1 hy.1) ((sAlg n).mul_mem hx.2 hy.2)
      convert this using 1
      funext u; simp [Complex.mul_re]
    · have := (sAlg n).add_mem ((sAlg n).mul_mem hx.1 hy.2) ((sAlg n).mul_mem hx.2 hy.1)
      convert this using 1
      funext u; simp [Complex.mul_im]

end Weyl
end SecularForm
end KAM.Planetary
