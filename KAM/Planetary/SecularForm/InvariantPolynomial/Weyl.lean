module

public import Mathlib
public import KAM.Planetary.SecularForm.InvariantPolynomial.Generators

/-!
# First fundamental theorem for `O(2)`

`bpP:p8:e-weyl`: a polynomial in `n` planar vectors invariant under the simultaneous action of
`O(2)` is a polynomial in the dot products.  Rotation invariance puts the polynomial in the algebra
generated by `z_j w_k = d_{jk} + i c_{jk}` (`Balanced`, `Generators`); invariance under the
reflection `diag(1, -1)`, which fixes the dot products and negates the cross products, then
removes the cross products.
-/

@[expose] public noncomputable section
open MvPolynomial
namespace KAM.Planetary
namespace SecularForm
namespace Weyl

variable {n : ℕ}

/-- The reflection `diag(1, -1)`. -/
def refl : Matrix (Fin 2) (Fin 2) ℝ := !![1, 0; 0, -1]

theorem refl_orth : refl.transpose * refl = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [refl, Matrix.mul_apply, Fin.sum_univ_two]

/-- The reflection applied to every vector. -/
def reflPt (u : Pt n) : Pt n := fun k => refl.mulVec (u k)

theorem dot_reflPt (j k : Fin n) (u : Pt n) : dotFn j k (reflPt u) = dotFn j k u := by
  simp [dotFn, reflPt, refl, planeDot, Fin.sum_univ_two, Matrix.mulVec, dotProduct]

theorem cross_reflPt (j k : Fin n) (u : Pt n) : crossFn j k (reflPt u) = -crossFn j k u := by
  simp [crossFn, reflPt, refl, Fin.sum_univ_two, Matrix.mulVec, dotProduct]; ring

theorem reflPt_dAlg {f : Pt n → ℝ} (hf : f ∈ dAlg n) (u : Pt n) : f (reflPt u) = f u := by
  induction hf using Algebra.adjoin_induction with
  | mem x hx => obtain ⟨⟨j, k⟩, rfl⟩ := hx; exact dot_reflPt j k u
  | algebraMap r => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | mul x y _ _ hx hy => simp [hx, hy]

theorem reflPt_odd {f : Pt n → ℝ} (hf : IsOdd f) (u : Pt n) : f (reflPt u) = -f u := by
  obtain ⟨a, ha, rfl⟩ := hf
  simp only [Finset.sum_apply, Pi.mul_apply, cross_reflPt, ← Finset.sum_neg_distrib]
  exact Finset.sum_congr rfl fun p _ => by rw [reflPt_dAlg (ha p) u]; ring

theorem mem_dAlg_of_refl {f : Pt n → ℝ} (hf : f ∈ sAlg n) (h : ∀ u, f (reflPt u) = f u) :
    f ∈ dAlg n := by
  obtain ⟨e, he, v, hv, rfl⟩ := hf
  have hv0 : v = 0 := by
    funext u
    have h1 := h u
    simp only [Pi.add_apply, reflPt_dAlg he, reflPt_odd hv] at h1
    simp only [Pi.zero_apply]
    linarith
  subst hv0
  simpa using he

theorem aeval_apply_pi {σ : Type*} (x : σ → Pt n → ℝ) (Q : MvPolynomial σ ℝ) (u : Pt n) :
    (MvPolynomial.aeval x Q) u = MvPolynomial.eval (fun i => x i u) Q := by
  induction Q using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

end Weyl

variable {n : ℕ}

open Weyl in
/-- Simultaneous orthogonal invariance implies generation by dot products. -/
theorem e_weyl (P : MvPolynomial (Fin n × Fin 2) ℝ)
    (hInv : ∀ R : Matrix (Fin 2) (Fin 2) ℝ, R.transpose*R = 1 →
      ∀ u : Fin n → Fin 2 → ℝ,
      MvPolynomial.eval (fun ic => (R.mulVec (u ic.1)) ic.2) P =
        MvPolynomial.eval (fun ic => u ic.1 ic.2) P) :
    ∃ Q : MvPolynomial (Fin n × Fin n) ℝ, ∀ u : Fin n → Fin 2 → ℝ,
      MvPolynomial.eval (fun ic => u ic.1 ic.2) P =
        MvPolynomial.eval (fun ij => planeDot (u ij.1) (u ij.2)) Q := by
  set Pf : Pt n → ℝ := fun u => MvPolynomial.eval (fun ic => u ic.1 ic.2) P with hPf
  have hbal : ∀ u, (Pf u : ℂ) = MvPolynomial.eval (zw u) (balancedPart (toZW P)) := fun u => by
    rw [eval_balancedPart_toZW P hInv u, eval_toZW]
  have hS : Pf ∈ sAlg n := by
    have := (re_im_mem_sAlg (balancedPart_mem (toZW P))).1
    convert this using 1
    funext u
    rw [← hbal u]
    simp
  have hD : Pf ∈ dAlg n := mem_dAlg_of_refl hS (fun u => hInv refl refl_orth u)
  rw [dAlg, Algebra.adjoin_range_eq_range_aeval] at hD
  obtain ⟨Q, hQ⟩ := hD
  refine ⟨Q, fun u => ?_⟩
  have hQ' : MvPolynomial.aeval (fun jk : Fin n × Fin n => dotFn jk.1 jk.2) Q = Pf := hQ
  have := congrFun hQ' u
  rw [aeval_apply_pi] at this
  exact this.symm

end SecularForm
end KAM.Planetary
