module

public import KAM.EffectiveStability.SJSU.Ham.Hw.T1
public import KAM.EffectiveStability.SJSU.Ham.Hw.H1P0

/-!
# `H_w = Sᵀ C S` in degree 1: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `H_w = Sᵀ C S` in degree 1. -/
def sjsuH1 : List (List ℤ) :=
  [sjsuH1R0, sjsuH1R1, sjsuH1R2]

theorem sjsuH1_len : sjsuH1.length = sjsuA1.length := by rfl

theorem sjsuH1_rowlen : ∀ r ∈ sjsuH1, r.length = sjsuA1.length := by
  decide +kernel

theorem sjsuH1_row0 : listBEq (linComb sjsuA1.length
    (sjsuS1.map fun r => r.getD 0 0) sjsuT1) (sjsuH1.getD 0 []) = true := by
  decide +kernel

theorem sjsuH1_row1 : listBEq (linComb sjsuA1.length
    (sjsuS1.map fun r => r.getD 1 0) sjsuT1) (sjsuH1.getD 1 []) = true := by
  decide +kernel

theorem sjsuH1_row2 : listBEq (linComb sjsuA1.length
    (sjsuS1.map fun r => r.getD 2 0) sjsuT1) (sjsuH1.getD 2 []) = true := by
  decide +kernel

theorem sjsuH1_rows : ∀ k < sjsuA1.length, sjsuH1.getD k [] =
    linComb sjsuA1.length (sjsuS1.map fun r => r.getD k 0) sjsuT1 := by
  intro i hi
  have hi' : i < 3 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuH1_row0).symm
  · exact (eq_of_listBEq sjsuH1_row1).symm
  · exact (eq_of_listBEq sjsuH1_row2).symm

/-- **`H_w` in degree 1**: the degree-1 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH1_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 1).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA1 sjsuH1) w v := by
  rw [eq_of_listBEq sjsuCD1_check, bevalAt_eq_dense sjsuM sjsuA1 sjsuA1_nodup _
    sjsuCD1_keys sjsuS1 sjsuT1 sjsuH1 sjsuS1_len sjsuT1_len sjsuS1_rowlen
    sjsuT1_rowlen sjsuS1_rows sjsuT1_rows sjsuH1_rows,
    bevalAt_denseRows _ _ sjsuH1_len]

end KAM.EffectiveStability.SJSU

end
