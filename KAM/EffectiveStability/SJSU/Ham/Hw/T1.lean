module

public import KAM.EffectiveStability.SJSU.Ham.Hw.S1
public import KAM.EffectiveStability.SJSU.Ham.Hw.C1
public import KAM.EffectiveStability.SJSU.Ham.Hw.T1P0

/-!
# `T = C S` in degree 1: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `T = C S` in degree 1. -/
def sjsuT1 : List (List ℤ) :=
  [sjsuT1R0, sjsuT1R1, sjsuT1R2]

theorem sjsuT1_len : sjsuT1.length = sjsuA1.length := by rfl

theorem sjsuT1_rowlen : ∀ r ∈ sjsuT1, r.length = sjsuA1.length := by
  decide +kernel

theorem sjsuT1_row0 : listBEq (linComb sjsuA1.length
    (cRowOf sjsuA1 sjsuCD1.flatten (sjsuA1.getD 0 default)) sjsuS1)
    (sjsuT1.getD 0 []) = true := by
  decide +kernel

theorem sjsuT1_row1 : listBEq (linComb sjsuA1.length
    (cRowOf sjsuA1 sjsuCD1.flatten (sjsuA1.getD 1 default)) sjsuS1)
    (sjsuT1.getD 1 []) = true := by
  decide +kernel

theorem sjsuT1_row2 : listBEq (linComb sjsuA1.length
    (cRowOf sjsuA1 sjsuCD1.flatten (sjsuA1.getD 2 default)) sjsuS1)
    (sjsuT1.getD 2 []) = true := by
  decide +kernel

theorem sjsuT1_rows : ∀ i < sjsuA1.length, sjsuT1.getD i [] =
    linComb sjsuA1.length (cRowOf sjsuA1 sjsuCD1.flatten (sjsuA1.getD i default))
      sjsuS1 := by
  intro i hi
  have hi' : i < 3 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuT1_row0).symm
  · exact (eq_of_listBEq sjsuT1_row1).symm
  · exact (eq_of_listBEq sjsuT1_row2).symm

end KAM.EffectiveStability.SJSU

end
