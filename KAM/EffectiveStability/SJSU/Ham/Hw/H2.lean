module

public import KAM.EffectiveStability.SJSU.Ham.Hw.T2
public import KAM.EffectiveStability.SJSU.Ham.Hw.H2P0

/-!
# `H_w = Sᵀ C S` in degree 2: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `H_w = Sᵀ C S` in degree 2. -/
def sjsuH2 : List (List ℤ) :=
  [sjsuH2R0, sjsuH2R1, sjsuH2R2, sjsuH2R3, sjsuH2R4, sjsuH2R5]

theorem sjsuH2_len : sjsuH2.length = sjsuA2.length := by rfl

theorem sjsuH2_rowlen : ∀ r ∈ sjsuH2, r.length = sjsuA2.length := by
  decide +kernel

theorem sjsuH2_row0 : listBEq (linComb sjsuA2.length
    (sjsuS2.map fun r => r.getD 0 0) sjsuT2) (sjsuH2.getD 0 []) = true := by
  decide +kernel

theorem sjsuH2_row1 : listBEq (linComb sjsuA2.length
    (sjsuS2.map fun r => r.getD 1 0) sjsuT2) (sjsuH2.getD 1 []) = true := by
  decide +kernel

theorem sjsuH2_row2 : listBEq (linComb sjsuA2.length
    (sjsuS2.map fun r => r.getD 2 0) sjsuT2) (sjsuH2.getD 2 []) = true := by
  decide +kernel

theorem sjsuH2_row3 : listBEq (linComb sjsuA2.length
    (sjsuS2.map fun r => r.getD 3 0) sjsuT2) (sjsuH2.getD 3 []) = true := by
  decide +kernel

theorem sjsuH2_row4 : listBEq (linComb sjsuA2.length
    (sjsuS2.map fun r => r.getD 4 0) sjsuT2) (sjsuH2.getD 4 []) = true := by
  decide +kernel

theorem sjsuH2_row5 : listBEq (linComb sjsuA2.length
    (sjsuS2.map fun r => r.getD 5 0) sjsuT2) (sjsuH2.getD 5 []) = true := by
  decide +kernel

theorem sjsuH2_rows : ∀ k < sjsuA2.length, sjsuH2.getD k [] =
    linComb sjsuA2.length (sjsuS2.map fun r => r.getD k 0) sjsuT2 := by
  intro i hi
  have hi' : i < 6 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuH2_row0).symm
  · exact (eq_of_listBEq sjsuH2_row1).symm
  · exact (eq_of_listBEq sjsuH2_row2).symm
  · exact (eq_of_listBEq sjsuH2_row3).symm
  · exact (eq_of_listBEq sjsuH2_row4).symm
  · exact (eq_of_listBEq sjsuH2_row5).symm

/-- **`H_w` in degree 2**: the degree-2 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH2_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 2).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA2 sjsuH2) w v := by
  rw [eq_of_listBEq sjsuCD2_check, bevalAt_eq_dense sjsuM sjsuA2 sjsuA2_nodup _
    sjsuCD2_keys sjsuS2 sjsuT2 sjsuH2 sjsuS2_len sjsuT2_len sjsuS2_rowlen
    sjsuT2_rowlen sjsuS2_rows sjsuT2_rows sjsuH2_rows,
    bevalAt_denseRows _ _ sjsuH2_len]

end KAM.EffectiveStability.SJSU

end
