/-- **`H_w` in degree 5**: the degree-5 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH5_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 5).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA5 sjsuH5) w v := by
  rw [eq_of_listBEq sjsuCD5_check, bevalAt_eq_dense sjsuM sjsuA5 sjsuA5_nodup _
    sjsuCD5_keys sjsuS5 sjsuT5 sjsuH5 sjsuS5_len sjsuT5_len sjsuS5_rowlen
    sjsuT5_rowlen sjsuS5_rows sjsuT5_rows sjsuH5_rows,
    bevalAt_denseRows _ _ sjsuH5_len]

