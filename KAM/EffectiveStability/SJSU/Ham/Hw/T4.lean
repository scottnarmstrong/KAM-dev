/-- The rows of `T = C S` in degree 4. -/
def sjsuT4 : List (List ℤ) :=
  [sjsuT4R0, sjsuT4R1, sjsuT4R2, sjsuT4R3, sjsuT4R4, sjsuT4R5, sjsuT4R6, sjsuT4R7, sjsuT4R8,
    sjsuT4R9, sjsuT4R10, sjsuT4R11, sjsuT4R12, sjsuT4R13, sjsuT4R14]

theorem sjsuT4_len : sjsuT4.length = sjsuA4.length := by rfl

theorem sjsuT4_rowlen : ∀ r ∈ sjsuT4, r.length = sjsuA4.length := by
  decide +kernel

theorem sjsuT4_row0 : listBEq (linComb sjsuA4.length
