/-- **`H_w` in degree 9**: the degree-9 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH9_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 9).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA9 sjsuH9) w v := by
  rw [eq_of_listBEq sjsuCD9_check, bevalAt_eq_dense sjsuM sjsuA9 sjsuA9_nodup _
    sjsuCD9_keys sjsuS9 sjsuT9 sjsuH9 sjsuS9_len sjsuT9_len sjsuS9_rowlen
    sjsuT9_rowlen sjsuS9_rows sjsuT9_rows sjsuH9_rows,
    bevalAt_denseRows _ _ sjsuH9_len]

