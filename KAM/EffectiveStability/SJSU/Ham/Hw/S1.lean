module

public import KAM.EffectiveStability.SJSU.Ham.Hw.A
public import KAM.EffectiveStability.SJSU.Ham.Rot
public import KAM.EffectiveStability.Tube.Poly.Dense
public import Mathlib.Tactic.IntervalCases
public import KAM.EffectiveStability.SJSU.Ham.Hw.S1P0

/-!
# `S` in degree 1: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `S` in degree 1. -/
def sjsuS1 : List (List ℤ) :=
  [sjsuS1R0, sjsuS1R1, sjsuS1R2]

theorem sjsuS1_len : sjsuS1.length = sjsuA1.length := by rfl

theorem sjsuS1_rowlen : ∀ r ∈ sjsuS1, r.length = sjsuA1.length := by
  decide +kernel

theorem sjsuS1_row0 :
    listBEq (symPow sjsuM (sjsuA1.getD 0 default)) (sjsuA1.zip (sjsuS1.getD 0 [])) =
      true := by
  decide +kernel

theorem sjsuS1_row1 :
    listBEq (symPow sjsuM (sjsuA1.getD 1 default)) (sjsuA1.zip (sjsuS1.getD 1 [])) =
      true := by
  decide +kernel

theorem sjsuS1_row2 :
    listBEq (symPow sjsuM (sjsuA1.getD 2 default)) (sjsuA1.zip (sjsuS1.getD 2 [])) =
      true := by
  decide +kernel

theorem sjsuS1_rows : ∀ i < sjsuA1.length,
    symPow sjsuM (sjsuA1.getD i default) = sjsuA1.zip (sjsuS1.getD i []) := by
  intro i hi
  have hi' : i < 3 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact eq_of_listBEq sjsuS1_row0
  · exact eq_of_listBEq sjsuS1_row1
  · exact eq_of_listBEq sjsuS1_row2

end KAM.EffectiveStability.SJSU

end
