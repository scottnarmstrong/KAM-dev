module

public import KAM.EffectiveStability.SJSU.Ham.Hw.S3
public import KAM.EffectiveStability.SJSU.Ham.Hw.C3
public import KAM.EffectiveStability.SJSU.Ham.Hw.T3P0

/-!
# `T = C S` in degree 3: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `T = C S` in degree 3. -/
def sjsuT3 : List (List ℤ) :=
  [sjsuT3R0, sjsuT3R1, sjsuT3R2, sjsuT3R3, sjsuT3R4, sjsuT3R5, sjsuT3R6, sjsuT3R7, sjsuT3R8,
    sjsuT3R9]

theorem sjsuT3_len : sjsuT3.length = sjsuA3.length := by rfl

theorem sjsuT3_rowlen : ∀ r ∈ sjsuT3, r.length = sjsuA3.length := by
  decide +kernel

theorem sjsuT3_row0 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 0 default)) sjsuS3)
    (sjsuT3.getD 0 []) = true := by
  decide +kernel

theorem sjsuT3_row1 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 1 default)) sjsuS3)
    (sjsuT3.getD 1 []) = true := by
  decide +kernel

theorem sjsuT3_row2 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 2 default)) sjsuS3)
    (sjsuT3.getD 2 []) = true := by
  decide +kernel

theorem sjsuT3_row3 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 3 default)) sjsuS3)
    (sjsuT3.getD 3 []) = true := by
  decide +kernel

theorem sjsuT3_row4 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 4 default)) sjsuS3)
    (sjsuT3.getD 4 []) = true := by
  decide +kernel

theorem sjsuT3_row5 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 5 default)) sjsuS3)
    (sjsuT3.getD 5 []) = true := by
  decide +kernel

theorem sjsuT3_row6 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 6 default)) sjsuS3)
    (sjsuT3.getD 6 []) = true := by
  decide +kernel

theorem sjsuT3_row7 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 7 default)) sjsuS3)
    (sjsuT3.getD 7 []) = true := by
  decide +kernel

theorem sjsuT3_row8 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 8 default)) sjsuS3)
    (sjsuT3.getD 8 []) = true := by
  decide +kernel

theorem sjsuT3_row9 : listBEq (linComb sjsuA3.length
    (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD 9 default)) sjsuS3)
    (sjsuT3.getD 9 []) = true := by
  decide +kernel

theorem sjsuT3_rows : ∀ i < sjsuA3.length, sjsuT3.getD i [] =
    linComb sjsuA3.length (cRowOf sjsuA3 sjsuCD3.flatten (sjsuA3.getD i default))
      sjsuS3 := by
  intro i hi
  have hi' : i < 10 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuT3_row0).symm
  · exact (eq_of_listBEq sjsuT3_row1).symm
  · exact (eq_of_listBEq sjsuT3_row2).symm
  · exact (eq_of_listBEq sjsuT3_row3).symm
  · exact (eq_of_listBEq sjsuT3_row4).symm
  · exact (eq_of_listBEq sjsuT3_row5).symm
  · exact (eq_of_listBEq sjsuT3_row6).symm
  · exact (eq_of_listBEq sjsuT3_row7).symm
  · exact (eq_of_listBEq sjsuT3_row8).symm
  · exact (eq_of_listBEq sjsuT3_row9).symm

end KAM.EffectiveStability.SJSU

end
