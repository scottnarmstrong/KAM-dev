/-!
# `S` in degree 2: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `S` in degree 2. -/
def sjsuS2 : List (List ℤ) :=
  [sjsuS2R0, sjsuS2R1, sjsuS2R2, sjsuS2R3, sjsuS2R4, sjsuS2R5]

theorem sjsuS2_len : sjsuS2.length = sjsuA2.length := by rfl

theorem sjsuS2_rowlen : ∀ r ∈ sjsuS2, r.length = sjsuA2.length := by
  decide +kernel

theorem sjsuS2_row0 :
    listBEq (symPow sjsuM (sjsuA2.getD 0 default)) (sjsuA2.zip (sjsuS2.getD 0 [])) =
      true := by
  decide +kernel

theorem sjsuS2_row1 :
    listBEq (symPow sjsuM (sjsuA2.getD 1 default)) (sjsuA2.zip (sjsuS2.getD 1 [])) =
      true := by
  decide +kernel

theorem sjsuS2_row2 :
    listBEq (symPow sjsuM (sjsuA2.getD 2 default)) (sjsuA2.zip (sjsuS2.getD 2 [])) =
      true := by
  decide +kernel

theorem sjsuS2_row3 :
    listBEq (symPow sjsuM (sjsuA2.getD 3 default)) (sjsuA2.zip (sjsuS2.getD 3 [])) =
      true := by
  decide +kernel

theorem sjsuS2_row4 :
    listBEq (symPow sjsuM (sjsuA2.getD 4 default)) (sjsuA2.zip (sjsuS2.getD 4 [])) =
      true := by
  decide +kernel

theorem sjsuS2_row5 :
    listBEq (symPow sjsuM (sjsuA2.getD 5 default)) (sjsuA2.zip (sjsuS2.getD 5 [])) =
      true := by
  decide +kernel

theorem sjsuS2_rows : ∀ i < sjsuA2.length,
    symPow sjsuM (sjsuA2.getD i default) = sjsuA2.zip (sjsuS2.getD i []) := by
  intro i hi
  have hi' : i < 6 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact eq_of_listBEq sjsuS2_row0
  · exact eq_of_listBEq sjsuS2_row1
  · exact eq_of_listBEq sjsuS2_row2
  · exact eq_of_listBEq sjsuS2_row3
  · exact eq_of_listBEq sjsuS2_row4
  · exact eq_of_listBEq sjsuS2_row5

end KAM.EffectiveStability.SJSU

