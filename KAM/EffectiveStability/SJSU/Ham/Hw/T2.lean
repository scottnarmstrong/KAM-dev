module

public import KAM.EffectiveStability.SJSU.Ham.Hw.S2
public import KAM.EffectiveStability.SJSU.Ham.Hw.C2
public import KAM.EffectiveStability.SJSU.Ham.Hw.T2P0

/-!
# `T = C S` in degree 2: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `T = C S` in degree 2. -/
def sjsuT2 : List (List ℤ) :=
  [sjsuT2R0, sjsuT2R1, sjsuT2R2, sjsuT2R3, sjsuT2R4, sjsuT2R5]

theorem sjsuT2_len : sjsuT2.length = sjsuA2.length := by rfl

theorem sjsuT2_rowlen : ∀ r ∈ sjsuT2, r.length = sjsuA2.length := by
  decide +kernel

theorem sjsuT2_row0 : listBEq (linComb sjsuA2.length
    (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD 0 default)) sjsuS2)
    (sjsuT2.getD 0 []) = true := by
  decide +kernel

theorem sjsuT2_row1 : listBEq (linComb sjsuA2.length
    (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD 1 default)) sjsuS2)
    (sjsuT2.getD 1 []) = true := by
  decide +kernel

theorem sjsuT2_row2 : listBEq (linComb sjsuA2.length
    (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD 2 default)) sjsuS2)
    (sjsuT2.getD 2 []) = true := by
  decide +kernel

theorem sjsuT2_row3 : listBEq (linComb sjsuA2.length
    (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD 3 default)) sjsuS2)
    (sjsuT2.getD 3 []) = true := by
  decide +kernel

theorem sjsuT2_row4 : listBEq (linComb sjsuA2.length
    (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD 4 default)) sjsuS2)
    (sjsuT2.getD 4 []) = true := by
  decide +kernel

theorem sjsuT2_row5 : listBEq (linComb sjsuA2.length
    (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD 5 default)) sjsuS2)
    (sjsuT2.getD 5 []) = true := by
  decide +kernel

theorem sjsuT2_rows : ∀ i < sjsuA2.length, sjsuT2.getD i [] =
    linComb sjsuA2.length (cRowOf sjsuA2 sjsuCD2.flatten (sjsuA2.getD i default))
      sjsuS2 := by
  intro i hi
  have hi' : i < 6 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuT2_row0).symm
  · exact (eq_of_listBEq sjsuT2_row1).symm
  · exact (eq_of_listBEq sjsuT2_row2).symm
  · exact (eq_of_listBEq sjsuT2_row3).symm
  · exact (eq_of_listBEq sjsuT2_row4).symm
  · exact (eq_of_listBEq sjsuT2_row5).symm

end KAM.EffectiveStability.SJSU

end
