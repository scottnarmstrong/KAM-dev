/-- **`H_w` in degree 6**: the degree-6 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH6_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 6).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA6 sjsuH6) w v := by
  rw [eq_of_listBEq sjsuCD6_check, bevalAt_eq_dense sjsuM sjsuA6 sjsuA6_nodup _
    sjsuCD6_keys sjsuS6 sjsuT6 sjsuH6 sjsuS6_len sjsuT6_len sjsuS6_rowlen
    sjsuT6_rowlen sjsuS6_rows sjsuT6_rows sjsuH6_rows,
    bevalAt_denseRows _ _ sjsuH6_len]

