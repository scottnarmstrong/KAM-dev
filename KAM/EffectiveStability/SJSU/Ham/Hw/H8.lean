/-- **`H_w` in degree 8**: the degree-8 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH8_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 8).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA8 sjsuH8) w v := by
  rw [eq_of_listBEq sjsuCD8_check, bevalAt_eq_dense sjsuM sjsuA8 sjsuA8_nodup _
    sjsuCD8_keys sjsuS8 sjsuT8 sjsuH8 sjsuS8_len sjsuT8_len sjsuS8_rowlen
    sjsuT8_rowlen sjsuS8_rows sjsuT8_rows sjsuH8_rows,
    bevalAt_denseRows _ _ sjsuH8_len]

