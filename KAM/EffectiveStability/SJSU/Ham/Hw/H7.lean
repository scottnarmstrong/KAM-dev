/-- **`H_w` in degree 7**: the degree-7 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH7_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 7).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA7 sjsuH7) w v := by
  rw [eq_of_listBEq sjsuCD7_check, bevalAt_eq_dense sjsuM sjsuA7 sjsuA7_nodup _
    sjsuCD7_keys sjsuS7 sjsuT7 sjsuH7 sjsuS7_len sjsuT7_len sjsuS7_rowlen
    sjsuT7_rowlen sjsuS7_rows sjsuT7_rows sjsuH7_rows,
    bevalAt_denseRows _ _ sjsuH7_len]

