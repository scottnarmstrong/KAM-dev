module

public import KAM.EffectiveStability.SJSU.Ham.Hw.T3
public import KAM.EffectiveStability.SJSU.Ham.Hw.H3P0

/-!
# `H_w = Sᵀ C S` in degree 3: rows and kernel checks (T2-CONF, N5a; generated by `gen_ham_lean.py`)
-/

@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `H_w = Sᵀ C S` in degree 3. -/
def sjsuH3 : List (List ℤ) :=
  [sjsuH3R0, sjsuH3R1, sjsuH3R2, sjsuH3R3, sjsuH3R4, sjsuH3R5, sjsuH3R6, sjsuH3R7, sjsuH3R8,
    sjsuH3R9]

theorem sjsuH3_len : sjsuH3.length = sjsuA3.length := by rfl

theorem sjsuH3_rowlen : ∀ r ∈ sjsuH3, r.length = sjsuA3.length := by
  decide +kernel

theorem sjsuH3_row0 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 0 0) sjsuT3) (sjsuH3.getD 0 []) = true := by
  decide +kernel

theorem sjsuH3_row1 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 1 0) sjsuT3) (sjsuH3.getD 1 []) = true := by
  decide +kernel

theorem sjsuH3_row2 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 2 0) sjsuT3) (sjsuH3.getD 2 []) = true := by
  decide +kernel

theorem sjsuH3_row3 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 3 0) sjsuT3) (sjsuH3.getD 3 []) = true := by
  decide +kernel

theorem sjsuH3_row4 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 4 0) sjsuT3) (sjsuH3.getD 4 []) = true := by
  decide +kernel

theorem sjsuH3_row5 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 5 0) sjsuT3) (sjsuH3.getD 5 []) = true := by
  decide +kernel

theorem sjsuH3_row6 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 6 0) sjsuT3) (sjsuH3.getD 6 []) = true := by
  decide +kernel

theorem sjsuH3_row7 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 7 0) sjsuT3) (sjsuH3.getD 7 []) = true := by
  decide +kernel

theorem sjsuH3_row8 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 8 0) sjsuT3) (sjsuH3.getD 8 []) = true := by
  decide +kernel

theorem sjsuH3_row9 : listBEq (linComb sjsuA3.length
    (sjsuS3.map fun r => r.getD 9 0) sjsuT3) (sjsuH3.getD 9 []) = true := by
  decide +kernel

theorem sjsuH3_rows : ∀ k < sjsuA3.length, sjsuH3.getD k [] =
    linComb sjsuA3.length (sjsuS3.map fun r => r.getD k 0) sjsuT3 := by
  intro i hi
  have hi' : i < 10 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuH3_row0).symm
  · exact (eq_of_listBEq sjsuH3_row1).symm
  · exact (eq_of_listBEq sjsuH3_row2).symm
  · exact (eq_of_listBEq sjsuH3_row3).symm
  · exact (eq_of_listBEq sjsuH3_row4).symm
  · exact (eq_of_listBEq sjsuH3_row5).symm
  · exact (eq_of_listBEq sjsuH3_row6).symm
  · exact (eq_of_listBEq sjsuH3_row7).symm
  · exact (eq_of_listBEq sjsuH3_row8).symm
  · exact (eq_of_listBEq sjsuH3_row9).symm

/-- **`H_w` in degree 3**: the degree-3 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH3_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 3).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA3 sjsuH3) w v := by
  rw [eq_of_listBEq sjsuCD3_check, bevalAt_eq_dense sjsuM sjsuA3 sjsuA3_nodup _
    sjsuCD3_keys sjsuS3 sjsuT3 sjsuH3 sjsuS3_len sjsuT3_len sjsuS3_rowlen
    sjsuT3_rowlen sjsuS3_rows sjsuT3_rows sjsuH3_rows,
    bevalAt_denseRows _ _ sjsuH3_len]

end KAM.EffectiveStability.SJSU

end
