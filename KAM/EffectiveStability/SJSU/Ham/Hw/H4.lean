@[expose] public section

namespace KAM.EffectiveStability.SJSU

open KAM.EffectiveStability.Tube

/-- The rows of `H_w = Sᵀ C S` in degree 4. -/
def sjsuH4 : List (List ℤ) :=
  [sjsuH4R0, sjsuH4R1, sjsuH4R2, sjsuH4R3, sjsuH4R4, sjsuH4R5, sjsuH4R6, sjsuH4R7, sjsuH4R8,
    sjsuH4R9, sjsuH4R10, sjsuH4R11, sjsuH4R12, sjsuH4R13, sjsuH4R14]

theorem sjsuH4_len : sjsuH4.length = sjsuA4.length := by rfl

theorem sjsuH4_rowlen : ∀ r ∈ sjsuH4, r.length = sjsuA4.length := by
  decide +kernel

theorem sjsuH4_row0 : listBEq (linComb sjsuA4.length
    (sjsuS4.map fun r => r.getD 0 0) sjsuT4) (sjsuH4.getD 0 []) = true := by
  decide +kernel

theorem sjsuH4_row1 : listBEq (linComb sjsuA4.length
    (sjsuS4.map fun r => r.getD 1 0) sjsuT4) (sjsuH4.getD 1 []) = true := by
