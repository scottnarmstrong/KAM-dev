theorem sjsuH4_rows : ∀ k < sjsuA4.length, sjsuH4.getD k [] =
    linComb sjsuA4.length (sjsuS4.map fun r => r.getD k 0) sjsuT4 := by
  intro i hi
  have hi' : i < 15 := lt_of_lt_of_eq hi (by rfl)
  interval_cases i
  · exact (eq_of_listBEq sjsuH4_row0).symm
  · exact (eq_of_listBEq sjsuH4_row1).symm
  · exact (eq_of_listBEq sjsuH4_row2).symm
  · exact (eq_of_listBEq sjsuH4_row3).symm
  · exact (eq_of_listBEq sjsuH4_row4).symm
  · exact (eq_of_listBEq sjsuH4_row5).symm
  · exact (eq_of_listBEq sjsuH4_row6).symm
  · exact (eq_of_listBEq sjsuH4_row7).symm
  · exact (eq_of_listBEq sjsuH4_row8).symm
  · exact (eq_of_listBEq sjsuH4_row9).symm
  · exact (eq_of_listBEq sjsuH4_row10).symm
  · exact (eq_of_listBEq sjsuH4_row11).symm
  · exact (eq_of_listBEq sjsuH4_row12).symm
  · exact (eq_of_listBEq sjsuH4_row13).symm
  · exact (eq_of_listBEq sjsuH4_row14).symm

/-- **`H_w` in degree 4**: the degree-4 model rows at `(M w, M v)` are the dense
`H_w` rows at `(w, v)`. -/
theorem sjsuH4_eval {R : Type*} [CommRing R] (w v : Fin 3 → R) :
    bevalAt (sjsuIntChunks 4).flatten (sjsuM.apply w) (sjsuM.apply v) =
      bevalAt (denseRows sjsuA4 sjsuH4) w v := by
  rw [eq_of_listBEq sjsuCD4_check, bevalAt_eq_dense sjsuM sjsuA4 sjsuA4_nodup _
    sjsuCD4_keys sjsuS4 sjsuT4 sjsuH4 sjsuS4_len sjsuT4_len sjsuS4_rowlen
    sjsuT4_rowlen sjsuS4_rows sjsuT4_rows sjsuH4_rows,
    bevalAt_denseRows _ _ sjsuH4_len]

end KAM.EffectiveStability.SJSU

