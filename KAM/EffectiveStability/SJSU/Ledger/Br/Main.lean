/-- **The kept bracket coefficients** of `{f_j, h~}` (N9's `hG`). -/
theorem sjsu_G_bound (j : Fin 3) : ∀ p ∈ truncSet (Fin 3) 8, ∀ φ : Fin 2 → ℝ,
    |((bterms (Ftab j) sjsuMons).filter fun b =>
      decide (b.mon (fun e => monOf e.1) monOf = p)).map (fun b =>
        (b.coef (fun e => monOf e.1) monOf : ℝ) *
          b.val (fun e => (e.2.opd Fprm.w Fprm.S).eval Fprm.S)
            (fun t => ((sjsuHD.H t).opd sjsuHD.P).eval sjsuHD.P.S) φ) |>.sum| ≤
      ((sjsuG j (p 0, p 1, p 2) : ℚ) : ℝ) := by
  intro p hp φ
  have hp' : mdeg p ≤ 8 := mem_truncSet_iff.mp hp
  fin_cases j
  · exact brAllC_sound (D := brD 0) (P0 := sjsuHD.P) br_all_0 brMons_nodup brInH_iff
      brD_ok_0 Fprm.w rfl rfl p hp' φ
  · exact brAllC_sound (D := brD 1) (P0 := sjsuHD.P) br_all_1 brMons_nodup brInH_iff
      brD_ok_1 Fprm.w rfl rfl p hp' φ
  · exact brAllC_sound (D := brD 2) (P0 := sjsuHD.P) br_all_2 brMons_nodup brInH_iff
      brD_ok_2 Fprm.w rfl rfl p hp' φ

theorem brN_ok : (sjsuMons.all fun t => (sjsuHD.H t).ok brPb &&
    (sjsuHD.H t).l1Check brPb (brNH t)) = true := by
  refine all_of_chunks _ _ brH_len fun k hk => ?_
  interval_cases k
  exacts [brc_n_0, brc_n_1, brc_n_2, brc_n_3, brc_n_4, brc_n_5, brc_n_6, brc_n_7, brc_n_8, brc_n_9,
    brc_n_10, brc_n_11, brc_n_12, brc_n_13, brc_n_14, brc_n_15, brc_n_16, brc_n_17, brc_n_18,
    brc_n_19, brc_n_20, brc_n_21, brc_n_22, brc_n_23, brc_n_24, brc_n_25, brc_n_26, brc_n_27]

/-- **The dropped bracket terms** of `{f_j, h~}` (N9's `hDrop`, `L = 8`, `r = 2·10⁻⁶`). -/
theorem sjsu_drop_bound (j : Fin 3) {u : Fin 3 → ℝ} (hu : ∀ l, |u l| ≤ ((2 / 1000000 : ℚ) : ℝ))
    (φ : Fin 2 → ℝ) :
    |((bterms (Ftab j) sjsuMons).filter fun b => decide (8 < mdeg (b.mon (fun e => monOf e.1)
      monOf))).map (fun b => (b.coef (fun e => monOf e.1) monOf : ℝ) *
        umon (b.mon (fun e => monOf e.1) monOf) u *
          b.val (fun e => (e.2.opd Fprm.w Fprm.S).eval Fprm.S)
            (fun t => ((sjsuHD.H t).opd sjsuHD.P).eval sjsuHD.P.S) φ) |>.sum| ≤
      ((sjsuDrop j : ℚ) : ℝ) := by
  have hH : ∀ t ∈ sjsuMons, (sjsuHD.H t).ok brPb = true ∧
      (sjsuHD.H t).l1Check brPb (brNH t) = true := fun t ht => by
    simpa only [Bool.and_eq_true] using List.all_eq_true.mp brN_ok t ht
  fin_cases j
  · exact dropCheck_sound brdrop_0 (by decide) (List.all_eq_true.mp brc_fok_0) hH Fprm.w
      (P0 := sjsuHD.P) rfl rfl hu φ
  · exact dropCheck_sound brdrop_1 (by decide) (List.all_eq_true.mp brc_fok_1) hH Fprm.w
      (P0 := sjsuHD.P) rfl rfl hu φ
  · exact dropCheck_sound brdrop_2 (by decide) (List.all_eq_true.mp brc_fok_2) hH Fprm.w
      (P0 := sjsuHD.P) rfl rfl hu φ

end KAM.EffectiveStability.SJSU

