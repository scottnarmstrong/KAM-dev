module

public import KAM.EffectiveStability.HenonHeiles.Cert
public import KAM.EffectiveStability.HenonHeiles.ChunkMerge
public import KAM.EffectiveStability.HenonHeiles.Data.Lie2Accs

/-!
# Shard Lie2: the step-2 Lie identity (track B, B3-CERT)

Kernel check of the identity `cartEqCheck P Q = true` with
`P = cartLieSum hhStep2.gen hhStep1.out hhStep2.order`
and `Q = hhStep2.out`,
replayed in 5 chunks of 250 monomials (`ChunkMerge`), each chunk a separate
`decide +kernel` theorem. Generated by `docs/tracks/B/b3/producer/gen_chunks.py`; do not edit.
-/

@[expose] public noncomputable section

namespace KAM.EffectiveStability.HenonHeiles

open CartPoly

/-- The trimmed unmerged difference checked by shard Lie2. -/
def hhLie2Y : List (CartMonoK QSqrt2) :=
  (cartSub
    (cartLieSum hhStep2.gen hhStep1.out hhStep2.order)
    (hhStep2.out)).map CartMonoK.cartMonoTrim

theorem hhLie2_c0 :
    ((hhLie2Y.drop 0).take 250).foldr cartInsertMono hhAccLie2_1 =
      hhAccLie2_0 := by
  decide +kernel

theorem hhLie2_c1 :
    ((hhLie2Y.drop 250).take 250).foldr cartInsertMono hhAccLie2_2 =
      hhAccLie2_1 := by
  decide +kernel

theorem hhLie2_c2 :
    ((hhLie2Y.drop 500).take 250).foldr cartInsertMono hhAccLie2_3 =
      hhAccLie2_2 := by
  decide +kernel

theorem hhLie2_c3 :
    ((hhLie2Y.drop 750).take 250).foldr cartInsertMono hhAccLie2_4 =
      hhAccLie2_3 := by
  decide +kernel

theorem hhLie2_c4 :
    ((hhLie2Y.drop 1000).take 250).foldr cartInsertMono hhAccLie2_5 =
      hhAccLie2_4 := by
  decide +kernel

theorem hhLie2_c5 : (hhLie2Y.drop 1250).foldr cartInsertMono [] = hhAccLie2_5 := by
  decide +kernel

theorem hhLie2_check :
    cartEqCheck (cartLieSum hhStep2.gen hhStep1.out hhStep2.order) (hhStep2.out) = true := by
  have h5 := hhLie2_c5
  have h4 := chunk_step hhLie2Y 1000 250 1250 rfl _ _ h5 hhLie2_c4
  have h3 := chunk_step hhLie2Y 750 250 1000 rfl _ _ h4 hhLie2_c3
  have h2 := chunk_step hhLie2Y 500 250 750 rfl _ _ h3 hhLie2_c2
  have h1 := chunk_step hhLie2Y 250 250 500 rfl _ _ h2 hhLie2_c1
  have h0 := chunk_step hhLie2Y 0 250 250 rfl _ _ h1 hhLie2_c0
  have h0' : hhLie2Y.foldr cartInsertMono [] = hhAccLie2_0 := by
    simpa only [List.drop_zero] using h0
  exact cartEqCheck_of_merge (A := hhAccLie2_0) h0' (by decide +kernel)

end KAM.EffectiveStability.HenonHeiles

end
