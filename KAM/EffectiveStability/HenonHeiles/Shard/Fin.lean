module

public import KAM.EffectiveStability.HenonHeiles.Cert
public import KAM.EffectiveStability.HenonHeiles.ChunkMerge
public import KAM.EffectiveStability.HenonHeiles.Data.FinAccs

/-!
# Shard Fin: the final identity `Q₃ = Nact(I) + P` (track B, B3-CERT)

Kernel check of the identity `cartEqCheck P Q = true` with
`P = hhStep3.out`
and `Q = cartAdd (cartActSubst hhNact) hhP`,
replayed in 7 chunks of 250 monomials (`ChunkMerge`), each chunk a separate
`decide +kernel` theorem. Generated by `docs/tracks/B/b3/producer/gen_chunks.py`; do not edit.
-/

@[expose] public noncomputable section

namespace KAM.EffectiveStability.HenonHeiles

open CartPoly

/-- The trimmed unmerged difference checked by shard Fin. -/
def hhFinY : List (CartMonoK QSqrt2) :=
  (cartSub
    (hhStep3.out)
    (cartAdd (cartActSubst hhNact) hhP)).map CartMonoK.cartMonoTrim

theorem hhFin_c0 :
    ((hhFinY.drop 0).take 250).foldr cartInsertMono hhAccFin_1 =
      hhAccFin_0 := by
  decide +kernel

theorem hhFin_c1 :
    ((hhFinY.drop 250).take 250).foldr cartInsertMono hhAccFin_2 =
      hhAccFin_1 := by
  decide +kernel

theorem hhFin_c2 :
    ((hhFinY.drop 500).take 250).foldr cartInsertMono hhAccFin_3 =
      hhAccFin_2 := by
  decide +kernel

theorem hhFin_c3 :
    ((hhFinY.drop 750).take 250).foldr cartInsertMono hhAccFin_4 =
      hhAccFin_3 := by
  decide +kernel

theorem hhFin_c4 :
    ((hhFinY.drop 1000).take 250).foldr cartInsertMono hhAccFin_5 =
      hhAccFin_4 := by
  decide +kernel

theorem hhFin_c5 :
    ((hhFinY.drop 1250).take 250).foldr cartInsertMono hhAccFin_6 =
      hhAccFin_5 := by
  decide +kernel

theorem hhFin_c6 :
    ((hhFinY.drop 1500).take 250).foldr cartInsertMono hhAccFin_7 =
      hhAccFin_6 := by
  decide +kernel

theorem hhFin_c7 : (hhFinY.drop 1750).foldr cartInsertMono [] = hhAccFin_7 := by
  decide +kernel

theorem hhFin_check :
    cartEqCheck (hhStep3.out) (cartAdd (cartActSubst hhNact) hhP) = true := by
  have h7 := hhFin_c7
  have h6 := chunk_step hhFinY 1500 250 1750 rfl _ _ h7 hhFin_c6
  have h5 := chunk_step hhFinY 1250 250 1500 rfl _ _ h6 hhFin_c5
  have h4 := chunk_step hhFinY 1000 250 1250 rfl _ _ h5 hhFin_c4
  have h3 := chunk_step hhFinY 750 250 1000 rfl _ _ h4 hhFin_c3
  have h2 := chunk_step hhFinY 500 250 750 rfl _ _ h3 hhFin_c2
  have h1 := chunk_step hhFinY 250 250 500 rfl _ _ h2 hhFin_c1
  have h0 := chunk_step hhFinY 0 250 250 rfl _ _ h1 hhFin_c0
  have h0' : hhFinY.foldr cartInsertMono [] = hhAccFin_0 := by
    simpa only [List.drop_zero] using h0
  exact cartEqCheck_of_merge (A := hhAccFin_0) h0' (by decide +kernel)

end KAM.EffectiveStability.HenonHeiles

end
