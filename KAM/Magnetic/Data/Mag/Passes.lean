/-- The frame majorants of the claim, from the four parts. -/
theorem mag_frame : checkFrameMajorants base (refinedWit.R.frame base.freqBox) = true := by
  simp only [checkFrameMajorants, Bool.and_eq_true]
  exact ⟨⟨⟨mag_frameL, mag_csFrameN⟩, mag_csFrameT⟩, mag_frameOm⟩

/-- `refinedCore` from its parts. -/
